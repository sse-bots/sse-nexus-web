# ==============================================================================
# SSE Bots Hub Web — Environment Configuration
# ==============================================================================

# Public URL of this website (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Random 32+ character secret for Better Auth sessions & OAuth signing
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-strong-32-plus-char-random-secret

# 32-byte hex key (64 hex chars) used to AES-256-GCM encrypt approved keys
# so they can be shown once/until redeemed on the user's web dashboard.
# Generate with: openssl rand -hex 32
KEY_ENCRYPTION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Same MongoDB cluster & database used by hub_bot.py and activation.py
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=sse_bots_user

# Discord OAuth2 App (from Discord Developer Portal)
# Add redirect URL: http://localhost:3000/api/auth/callback/discord
DISCORD_CLIENT_ID=your_discord_oauth_client_id
DISCORD_CLIENT_SECRET=your_discord_oauth_client_secret

# Discord Bot Tokens (used server-side to inspect servers, channels & support roles)
HUB_DISCORD_TOKEN=your_hub_bot_token
# Optional: if SSE Nexus is a separate bot from Hub, set its token and/or activation ID
NEXUS_DISCORD_TOKEN=
NEXUS_ACTIVATION_ID=
NEXT_PUBLIC_NEXUS_INVITE_URL=https://discord.com/oauth2/authorize?client_id=YOUR_NEXUS_BOT_ID&scope=bot%20applications.commands&permissions=8

# SSE Support Server & Hub Owner (must match hub_bot.py .env)
HUB_OWNER_ID=your_numeric_discord_user_id
HUB_SUPPORT_GUILD_ID=your_support_server_guild_id
NEXT_PUBLIC_SUPPORT_INVITE_URL=https://discord.gg/your-support-invite
