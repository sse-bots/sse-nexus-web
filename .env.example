# ==============================================================================
# SSE Nexus Web — Environment Configuration (Connected to SSE Accounts SSO)
# ==============================================================================

# Public URL of this SSE Nexus website (no trailing slash)
NEXT_PUBLIC_APP_URL=https://sse-nexus.vercel.app
BETTER_AUTH_URL=https://sse-nexus.vercel.app

# Random 32+ char secret for SSE Nexus local sessions (separate from SSE Accounts)
BETTER_AUTH_SECRET=replace-with-a-strong-32-plus-char-random-secret

# 32-byte hex key (64 hex chars) — MUST match hub_bot.py KEY_ENCRYPTION_SECRET
KEY_ENCRYPTION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# MongoDB Atlas (same database used by hub_bot.py and activation.py)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=sse_bots_user

# ==============================================================================
# Central SSE Accounts OAuth 2.1 / OIDC Client Credentials
# Register this app in https://sse-account.vercel.app/admin/oauth-clients
# Callback URL to register:
#   https://sse-nexus.vercel.app/api/auth/callback/sse
# ==============================================================================
SSE_ISSUER_URL=https://sse-account.vercel.app
NEXT_PUBLIC_SSE_ACCOUNTS_URL=https://sse-account.vercel.app
SSE_CLIENT_ID=your_client_id_from_sse_accounts
SSE_CLIENT_SECRET=your_client_secret_from_sse_accounts

# Discord Bot Tokens (server-side only — NO Discord OAuth client secret needed!)
HUB_DISCORD_TOKEN=your_hub_bot_token
NEXUS_DISCORD_TOKEN=
NEXUS_ACTIVATION_ID=
NEXT_PUBLIC_NEXUS_INVITE_URL=https://discord.com/oauth2/authorize?client_id=YOUR_NEXUS_BOT_ID&scope=bot%20applications.commands&permissions=8

# SSE Support Server & Hub Owner (must match hub_bot.py .env)
HUB_OWNER_ID=your_numeric_discord_user_id
HUB_SUPPORT_GUILD_ID=your_support_server_guild_id
NEXT_PUBLIC_SUPPORT_SERVER_INVITE=https://discord.gg/your-support-invite
